        {
          "use": { "ingredientId": "napa-cabbage" },
          "reason": "seasonal",
          "ratio": "1:1",
          "note": {
            "en": "Napa cabbage is at its September peak too and wilts the same way. Shred it a little finer, since it has no thick stems to soften.",
