  "ingredients": [
    {
      "ingredientId": "oyster-mushroom",
      "quantity": 400,
      "unit": "g",
      "substitutions": [
        {
          "use": { "ingredientId": "funnel-chanterelle" },
          "reason": "seasonal",
          "ratio": "1:1",
          "note": {
            "en": "September is its month. It will not shred into strands the way oyster mushroom does, so expect a looser filling rather than pulled-pork texture.",
            "fi": ""
          }
        },
        {
          "use": { "ingredientId": "button-mushroom" },
          "reason": "pantry",
          "ratio": "1:1",
          "note": {
            "en": "Always available and never a find. Slice rather than shred, and drive off the water properly before the soy and tomato go in.",
            "fi": ""
          }
        }
      ]
    },
    { "ingredientId": "yellow-onion", "quantity": 1 },
    { "ingredientId": "garlic", "quantity": 2, "unit": "clove" },
    { "ingredientId": "rapeseed-oil", "quantity": 1, "unit": "tbsp" },
    { "ingredientId": "soy-sauce", "quantity": 2, "unit": "tbsp" },
    { "ingredientId": "tomato-puree", "quantity": 1, "unit": "tbsp" },
    {
      "freeText": "maple syrup",
      "quantity": 1,
      "unit": "tbsp",
      "substitutions": [
        {
          "use": { "ingredientId": "syrup" },
          "reason": "pantry",
          "ratio": "1:1",
          "note": {
            "en": "Ordinary light syrup does the same job here. It is a teaspoon of sweetness against the soy, not a flavour you would miss.",
            "fi": ""
          }
        }
      ]
    },
    { "freeText": "smoked paprika powder", "quantity": 1, "unit": "tsp" },
    { "ingredientId": "cumin", "quantity": 0.5, "unit": "tsp" },
